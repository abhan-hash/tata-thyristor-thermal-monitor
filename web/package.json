{
  "name": "thermosense-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/check-tokens.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:property": "vitest run tests/property",
    "test:property:nightly": "FC_NUM_RUNS=2000 vitest run tests/property",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e",
    "screenshots": "playwright test tests/visual/capture.spec.ts",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:tokens"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-virtual": "^3.14.26",
    "@visx/axis": "^4.0.0",
    "@visx/event": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "d3-contour": "^4.0.3",
    "d3-shape": "^3.2.1",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-shape": "^3.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
